COMPOSE_PROJECT_NAME=restreamer-browser
PUBLIC_HOST=localhost
PUBLIC_ORIGIN=https://localhost:18443
HTTPS_PORT=18443
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-long-random-secret
# Run nvidia-smi --query-gpu=uuid,name,pci.bus_id --format=csv
# Explicitly select one GPU: never use all on a shared Plex host.
GPU_UUID=
GPU_BUS_ID=auto
# Optional host-specific DRM mappings if required by your driver/runtime.
GPU_RENDER_NODE=
GPU_CARD_NODE=
DEFAULT_WEBSITE=about:blank
# 0 removes the application concurrency cap; this does not patch NVIDIA drivers.
MAX_WORKERS=0
MAX_SESSIONS=1000
WORKER_CPUS=4
WORKER_MEMORY_MB=2048
WORKER_SHM_MB=512
